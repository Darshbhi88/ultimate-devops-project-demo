# Resource for Node Group
resource "aws_eks_node_group" "main" {
  for_each = var.node_groups

  cluster_name    = aws_eks_cluster.main.name   # Which Cluster
  node_group_name = each.key                    # Node Group Name --- General
  node_role_arn   = aws_iam_role.node.arn       # Role Attach
  subnet_ids      = var.subnet_ids              # Subnet Attach

  instance_types = each.value.instance_types
  capacity_type  = each.value.capacity_type

  scaling_config {
    desired_size = each.value.scaling_config.desired_size
    max_size     = each.value.scaling_config.max_size
    min_size     = each.value.scaling_config.min_size
  }

  depends_on = [
    aws_iam_role_policy_attachment.node_policy    
  ]
}
